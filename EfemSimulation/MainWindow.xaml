<Window x:Class="EfemSimulation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EfemSimulation"
        xmlns:WpfPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="반도체 웨이퍼 이송 시뮬레이터" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <!-- 그래프 영역 -->
            <ColumnDefinition Width="1*"/>
            <!-- 2D 미니맵 영역 -->
        </Grid.ColumnDefinitions>

        <!-- 1. 실시간 모터 속도 그래프 (ScottPlot) -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="■ 실시간 모터 변속량 (Speed)" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
            <WpfPlot:WpfPlot Name="SpeedPlot" Grid.Row="1"/>
        </Grid>

        <!-- 2. 2D 미니맵 및 시뮬레이션 제어 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="■ 2D 이송 미니맵 (X-Y Stage)" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- 미니맵 캔버스 (300x300 고정 비율 가정) -->
            <Border Grid.Row="1" Background="#2D2D2D" BorderBrush="#555555" BorderThickness="2" CornerRadius="8" ClipToBounds="True">
                <Canvas Name="MinimapCanvas" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 궤적 선 -->
                    <Polyline Name="TrajectoryLine" Stroke="#55FFFF" StrokeThickness="1" StrokeDashArray="2,2"/>

                    <!-- 출발지 (Green) -->
                    <Rectangle Name="StartStation" Width="40" Height="40" Fill="#22FF55" Opacity="0.4" Stroke="#22FF55" StrokeThickness="1"/>
                    <TextBlock Name="TxtStart" Text="START" Foreground="#22FF55" FontSize="10"/>

                    <!-- 목적지 (Red) -->
                    <Rectangle Name="TargetStation" Width="40" Height="40" Fill="#FF4444" Opacity="0.4" Stroke="#FF4444" StrokeThickness="1"/>
                    <TextBlock Name="TxtTarget" Text="TARGET" Foreground="#FF4444" FontSize="10"/>

                    <!-- 실제 이동하는 웨이퍼 (원형) -->
                    <Ellipse Name="Wafer" Width="30" Height="30" Fill="#E0E0E0" Stroke="#AAAAAA" StrokeThickness="1.5">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="10" Color="White" Opacity="0.3"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Border>

            <!-- 제어 버튼 -->
            <Button Grid.Row="2" Content="이송 시뮬레이션 시작" Click="BtnStart_Click" Height="40" Margin="0,15,0,0" 
                    Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </Grid>
    </Grid>
</Window>
