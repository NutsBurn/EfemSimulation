<Window x:Class="EfemSimulation.SpeedGraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EfemSimulation"
        xmlns:WpfPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="실시간 모터 속도 그래프" Height="500" Width="800" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="■ 실시간 모터 변속량 (Speed)" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
        <WpfPlot:WpfPlot Name="SpeedPlot" Grid.Row="1"/>
    </Grid>
</Window>
